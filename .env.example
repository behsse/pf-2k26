# Contact form delivery (app/api/contact/route.ts).
#
# Copy this file to .env.local for development, and set the same three keys as
# Environment Variables in the Vercel project for production. .env.local is
# git-ignored — never commit a real key.

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. The domain MUST be verified in Resend (SPF + DKIM records on
# behsse.fr) or the mail is rejected outright — or worse, delivered to spam
# from onboarding@resend.dev.
CONTACT_FROM_EMAIL=Behsse <contact@behsse.fr>

# Where submissions land.
CONTACT_TO_EMAIL=behsse.pro@gmail.com
